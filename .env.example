# Festify Configuration
FESTIFY_ENVIRONMENT=development
FESTIFY_APP_NAME="Festify — GenAI Event & Celebration Planner"
FESTIFY_SECRET_KEY=dev-only-insecure-secret-change-me
FESTIFY_DATABASE_URL=sqlite:///./festify.db
FESTIFY_TOKEN_EXPIRE_MINUTES=120
FESTIFY_RATE_LIMIT_REQUESTS=60
FESTIFY_RATE_LIMIT_WINDOW_SECONDS=60

# LLM Configuration (Set provider to "mock" for zero-cost offline tests & CI)
FESTIFY_LLM_PROVIDER=mock
FESTIFY_ANTHROPIC_API_KEY=
FESTIFY_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
